7) 20 COMPLETE ROGUE SETS
--------------------------------------------------------------------------

{
  "id": "rogue_sets",
  "set_count": 20,
  "set_size": 5,
  "class": "Rogue",
  "quality": 4,
  "required_level": [20, 80],
  "item_level": [50, 284],
  "target_kind": "general"
