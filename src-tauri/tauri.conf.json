{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WotLK Item Forge",
  "version": "0.1.1",
  "identifier": "com.modernmods.wotlkitemforge",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WotLK Item Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/wotlk-item-forge-engine"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AzerothCore WotLK item generation workbench",
    "longDescription": "Generate, validate, inspect, and revisit deterministic AzerothCore WotLK item packs from a native desktop workbench."
  }
}
